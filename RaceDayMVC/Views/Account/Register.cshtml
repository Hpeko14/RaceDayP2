@model RegisterVm
@{
    ViewData["Title"] = "Register";
}
<div class="rd-auth row g-0">
    <div class="col-lg-6 rd-auth-hero d-none d-lg-flex">
        <div>
            <h1 class="rd-heading text-white">Ready,<br />set, RaceDay.</h1>
            <p class="text-white-50">Join as a Participant to enter events and see your results, or as an Organiser to run them.</p>
        </div>
    </div>
    <div class="col-lg-6 p-4 p-md-5 bg-white">
        <h2 class="rd-heading">Create your account</h2>
        <form asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label">Full name</label>
                <input asp-for="Name" class="form-control" autocomplete="name" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Role" class="form-label">I am a</label>
                <select asp-for="Role" class="form-select">
                    <option value="Participant">Participant (I want to enter events)</option>
                    <option value="Organiser">Organiser (I run events)</option>
                </select>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-rd w-100">Register</button>
        </form>
        <p class="mt-3 mb-0 text-muted">Already registered? <a asp-action="Login">Log in</a></p>
    </div>
</div>