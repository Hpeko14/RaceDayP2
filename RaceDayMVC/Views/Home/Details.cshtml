@model EventDetailsVm
@{
    var ev = Model.Event;
    ViewData["Title"] = ev.Title;
}
<a asp-controller="Home" asp-action="Index" class="text-decoration-none small">&larr; Back</a>

<div class="card rd-card mt-2 mb-4">
    <div class="rd-detail-banner rd-placeholder"><span>@Fmt.TypeIcon(ev.EventType)</span></div>
    <div class="card-body p-4">
        <span class="badge rd-type">@ev.EventType</span>
        <h1 class="rd-heading mt-2">@ev.Title</h1>
        <div class="row g-3 my-2">
            <div class="col-6 col-md-3"><div class="rd-fact"><small>Date</small><strong>@Fmt.Date(ev.Date)</strong></div></div>
            <div class="col-6 col-md-3"><div class="rd-fact"><small>Location</small><strong>@ev.Location</strong></div></div>
            <div class="col-6 col-md-3"><div class="rd-fact"><small>Distance</small><strong>@Fmt.Distance(ev.Distance)</strong></div></div>
            <div class="col-6 col-md-3"><div class="rd-fact"><small>Type</small><strong>@ev.EventType</strong></div></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(ev.Description))
        {
            <p class="mt-3 mb-0">@ev.Description</p>
        }
    </div>
</div>

<h2 class="rd-heading h3">Categories</h2>
@if (Model.Categories.Count == 0)
{
    <p class="text-muted">The organiser has not added any categories yet.</p>
}
else
{
    <div class="table-responsive rd-table-wrap">
        <table class="table align-middle mb-0">
            <thead><tr><th>Category</th><th>Distance</th><th class="text-end">@(Model.IsParticipant ? "Enter" : "")</th></tr></thead>
            <tbody>
                @foreach (var c in Model.Categories)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td>@Fmt.Distance(c.Distance)</td>
                        <td class="text-end">
                            @if (Model.IsParticipant)
                            {
                                if (Model.EnrolledCategoryIds.Contains(c.CategoryID))
                                {
                                    <span class="rd-status rd-status-confirmed">Entered</span>
                                }
                                else
                                {
                                    <form asp-controller="Participant" asp-action="Enrol" method="post" class="d-inline">
                                        <input type="hidden" name="eventId" value="@ev.EventID" />
                                        <input type="hidden" name="categoryId" value="@c.CategoryID" />
                                        <button type="submit" class="btn btn-rd btn-sm">Enter Event</button>
                                    </form>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}