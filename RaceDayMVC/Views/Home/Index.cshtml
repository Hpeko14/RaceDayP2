@model HomeVm
@{
    ViewData["Title"] = "Upcoming events";
}
<div class="rd-hero mb-4">
    <h1 class="rd-heading text-white mb-1">Upcoming events</h1>
    <p class="text-white-50 mb-0">Pick your race, choose your category and get on the start line.</p>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-4 rd-filter">
    <div class="col-md-6">
        <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by event name or location" aria-label="Search events" />
    </div>
    <div class="col-md-3">
        <select name="eventType" class="form-select" aria-label="Event type">
            <option value="" selected="@(string.IsNullOrEmpty(Model.EventType))">All types</option>
            <option value="Run" selected="@(Model.EventType == "Run")">Run</option>
            <option value="Walk" selected="@(Model.EventType == "Walk")">Walk</option>
            <option value="Cycle" selected="@(Model.EventType == "Cycle")">Cycle</option>
        </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-rd flex-grow-1">Filter</button>
        <a asp-action="Index" class="btn btn-rd-outline-dark">Clear</a>
    </div>
</form>

@if (Model.Events.Count == 0)
{
    <div class="text-center rd-empty py-5">
        <div class="rd-big-icon">🔎</div>
        <h2 class="rd-heading">No upcoming events found</h2>
        <p class="text-muted">Try a different search or clear the filters.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var ev in Model.Events)
        {
            <div class="col-sm-6 col-lg-4">
                <partial name="_EventCard" model="ev" />
            </div>
        }
    </div>
}