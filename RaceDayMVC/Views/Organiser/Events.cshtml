@using RaceDayMVC.Models
@model List<EventItem>
@{
    ViewData["Title"] = "My events";
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="rd-heading mb-0">My events</h1>
    <a asp-action="CreateEvent" class="btn btn-rd">+ Create event</a>
</div>

@if (Model.Count == 0)
{
    <div class="text-center rd-empty py-5">
        <div class="rd-big-icon">🏁</div>
        <h2 class="rd-heading h4">No events yet</h2>
        <p class="text-muted">Create an event, then add categories for participants to enter.</p>
    </div>
}
else
{
    <div class="table-responsive rd-table-wrap">
        <table class="table align-middle mb-0">
            <thead><tr><th>Event</th><th>Type</th><th>Date</th><th>Location</th><th>Distance</th><th class="text-end">Manage</th></tr></thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td>
                            <a asp-controller="Home" asp-action="Details" asp-route-id="@e.EventID" class="fw-semibold text-decoration-none">@e.Title</a>
                        </td>
                        <td><span class="badge rd-type">@e.EventType</span></td>
                        <td>@Fmt.Date(e.Date)</td>
                        <td>@e.Location</td>
                        <td>@Fmt.Distance(e.Distance)</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="EditEvent" asp-route-id="@e.EventID" class="btn btn-sm btn-rd-outline-dark">Edit</a>
                            <a asp-action="Categories" asp-route-eventId="@e.EventID" class="btn btn-sm btn-rd-outline-dark">Categories</a>
                            <a asp-action="Enrolments" asp-route-eventId="@e.EventID" class="btn btn-sm btn-rd-outline-dark">Enrolments (@e.EnrollmentCount)</a>
                            <a asp-action="Results" asp-route-eventId="@e.EventID" class="btn btn-sm btn-rd-outline-dark">Results</a>
                            <form asp-action="DeleteEvent" asp-route-id="@e.EventID" method="post" class="d-inline" onsubmit="return confirm('Delete this event together with its categories, enrolments and results?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
