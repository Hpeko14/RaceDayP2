@model List<EnrollmentItem>
@{
    ViewData["Title"] = "My events";
}
<h1 class="rd-heading">My events</h1>
@if (Model.Count == 0)
{
    <div class="text-center rd-empty py-5">
        <div class="rd-big-icon">👟</div>
        <h2 class="rd-heading h4">You have not entered any events yet</h2>
        <a asp-controller="Home" asp-action="Index" class="btn btn-rd">Browse events</a>
    </div>
}
else
{
    <div class="table-responsive rd-table-wrap">
        <table class="table align-middle mb-0">
            <thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Registered</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td><a asp-controller="Home" asp-action="Details" asp-route-id="@e.EventID">@e.EventTitle</a></td>
                        <td>@Fmt.Date(e.EventDate)</td>
                        <td>@e.CategoryName</td>
                        <td>@Fmt.Date(e.RegistrationDate)</td>
                        <td><partial name="_StatusBadge" model="e.Status" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}