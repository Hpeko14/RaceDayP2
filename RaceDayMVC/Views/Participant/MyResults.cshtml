@model List<ResultItem>
@{
    ViewData["Title"] = "My results";
}
<h1 class="rd-heading">My results</h1>
@if (Model.Count == 0)
{
    <div class="text-center rd-empty py-5">
        <div class="rd-big-icon">🏅</div>
        <h2 class="rd-heading h4">No results yet</h2>
        <p class="text-muted">Your finish times appear here once an organiser has captured them after the event.</p>
    </div>
}
else
{
    <div class="table-responsive rd-table-wrap">
        <table class="table align-middle mb-0">
            <thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr></thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.EventTitle</td>
                        <td>@Fmt.Date(r.EventDate)</td>
                        <td>@r.CategoryName</td>
                        <td class="fw-semibold">@(r.FinishTime is null ? "-" : Fmt.Time(r.FinishTime))</td>
                        <td>
                            @if (r.Position is int position)
                            {
                                <span class="fw-semibold">@Fmt.Ordinal(position)</span>
                                @if (r.TotalFinishers > 0)
                                {
                                    <span class="text-muted"> out of @r.TotalFinishers finishers</span>
                                }
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}